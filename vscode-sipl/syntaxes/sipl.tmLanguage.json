{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SIPL",
  "scopeName": "source.sipl",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        { "name": "keyword.control.sipl", "match": "\\b(if|then|else|while|do)\\b" },
        { "name": "keyword.other.block.sipl", "match": "\\b(begin|end)\\b" },
        { "name": "keyword.other.skip.sipl", "match": "\\bskip\\b" },
        { "name": "keyword.operator.logical.sipl", "match": "\\b(or|not)\\b" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.integer.sipl",
      "match": "\\b[0-9]+\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.sipl", "match": ":=" },
        { "name": "keyword.operator.logical.sipl", "match": "[∨¬]" },
        { "name": "keyword.operator.comparison.sipl", "match": "[=>]" },
        { "name": "keyword.operator.arithmetic.sipl", "match": "[+\\-*]" },
        { "name": "punctuation.terminator.statement.sipl", "match": ";" },
        { "name": "punctuation.parenthesis.sipl", "match": "[()]" }
      ]
    },
    "variables": {
      "name": "variable.other.sipl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
